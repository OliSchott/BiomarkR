HeatMapData <- CorrectedDataNew %>%
filter(Protein %in% AllTerms$Protein) %>%
normalizeIntensityOnFeature(method = "zscore") %>%
group_by(Protein, Sample.TimeNew) %>%
summarise(Intensity = mean(Intensity), .groups = "drop")
##
TimePoints <- unique(HeatMapData$Sample.TimeNew)
FullTime <- seq(7,44, by = 1)
MissingTime <- setdiff(FullTime, TimePoints)
HeatMapData <- HeatMapData %>%
## add Missing time to SampleTimeNew with NA intensity
add_row(Protein = rep(unique(HeatMapData$Protein), each = length(MissingTime)), Sample.TimeNew = rep(MissingTime, times = length(unique(HeatMapData$Protein))), Intensity = NA)
HeatMapData$Sample.TimeNew = factor(HeatMapData$Sample.TimeNew, levels = sort(unique(HeatMapData$Sample.TimeNew)))
HeatMapDataQuant  <- HeatMapData %>% pivot_wider(names_from = Sample.TimeNew, values_from = Intensity) %>%
column_to_rownames(var = "Protein")
HeatMapReal <- ComplexHeatmap::Heatmap(HeatMapDataQuant,
column_order = as.character(sort(unique(HeatMapData$Sample.TimeNew))),
name = "Intensity",
cluster_rows = TRUE,
cluster_columns = FALSE,
clustering_distance_rows = "spearman",
row_split = 3)
## extract row names in order from heatmap
RowOrder <- ComplexHeatmap::row_order(HeatMapReal) %>% unlist()
ProteinsInOrder <- rownames(HeatMapDataQuant)[RowOrder]
HeatMapReal
ModelData <- CorrectedDataNew %>%
filter(Protein %in% AllTerms$Protein) %>%
## calculate harmonic model for every protein
group_by(Protein) %>%
nest() %>%
mutate(model = map(data, fit_harmonic_model),
tidied = map(model, tidy))
HeatMapData2 <- data.frame()
for(i in 1:length(unique(ModelData$Protein))){
PoI <- unique(ModelData$Protein)[i]
## use modles to predict intensity
Model <- ModelData %>% filter(Protein == PoI) %>% pull(model)
Model <- Model[[1]]
Predicted <- predict(Model, newdata = data.frame(Sample.TimeNew = seq(7, 44, by = 1)))
## put vlaues in HeatMapData2
HeatMapData2 <- rbind(HeatMapData2, data.frame(Protein = PoI, Sample.TimeNew = seq(7, 44, by = 1), Intensity = Predicted))
}
HeatMapData2 <- HeatMapData2 %>%
## calcualte z Scores for every protein
group_by(Protein) %>%
mutate(Intensity = (Intensity - mean(Intensity, na.rm = TRUE)) / sd(Intensity, na.rm = TRUE)) %>%
ungroup()
HeatMapData2$Sample.TimeNew = factor(HeatMapData2$Sample.TimeNew, levels = sort(unique(HeatMapData2$Sample.TimeNew)))
HeatMapDataQuant  <- HeatMapData2 %>% pivot_wider(names_from = Sample.TimeNew, values_from = Intensity) %>%
column_to_rownames(var = "Protein")
HeatMapSimulated <- ComplexHeatmap::Heatmap(HeatMapDataQuant,
column_order = as.character(sort(unique(HeatMapData$Sample.TimeNew))),
name = "Intensity",
cluster_rows = F,
row_order = ProteinsInOrder,
cluster_columns = FALSE,
clustering_distance_rows = "spearman")
HeatMapSimulated
## mixed effect model
library(lme4)
library(lmerTest)
fdr <- 0.05
Period <- 24
LMEData <- CorrectedDataNew %>% ungroup() %>%  mutate(Sample.TimeNew = as.numeric(Sample.TimeNew))
## define function
fit_lme_model <- function(data) {
lmerTest::lmer(Intensity ~sin(2 * pi * Sample.TimeNew / Period) + cos(2 * pi * Sample.TimeNew / Period) + (1 | Patient.ID), data = data)
}
results_lme <- CorrectedDataNew %>%
group_by(Protein) %>%
nest() %>%
mutate(
model = map(data, fit_lme_model),
stats = map(model, ~ broom.mixed::tidy(.x, effects = "fixed"))
) %>%
unnest(stats) %>%
filter(term %in% c("sin(2 * pi * Sample.TimeNew/Period)",
"cos(2 * pi * Sample.TimeNew/Period)"))
## adjust p value using BH method
results_lme <- results_lme %>%
mutate(p.adj = p.adjust(p.value, method = "BH"))
## extract significant proteins
significant_proteins_lme <- results_lme %>%
filter(p.adj < fdr) %>%
select(Protein, term, estimate, p.adj) %>%
pivot_wider(names_from = term, values_from = estimate)
PoIs <- significant_proteins_lme$Protein
PlotList <- list()
for(i in 1:length(PoIs)){
PoI <- PoIs[i]
Model <- results_lme %>% filter(Protein == PoI)
## extract significant term
Term <- Model$term
Term <- ifelse(length(Term) == 2,
"sin(2 * pi * Sample.TimeNew / Period) + cos(2 * pi * Sample.TimeNew / Period)",
Term)
## make formula
formula <- as.formula(paste("Intensity ~", Term))
PredData <- CorrectedDataNew %>%
filter(Protein == PoI) %>%
select(Sample.TimeNew, Intensity)
## predict using formula
PredData$Predicted <- predict(lm(formula, data = PredData), newdata = PredData)
plot <- CorrectedDataNew %>%
filter(Protein == PoI) %>%
ggplot(aes(x = Sample.TimeNew, y = Intensity)) +
geom_point() +
## plot predicted data
geom_smooth(data = PredData, aes(y = Predicted), color = "blue") +
labs(title = paste("LME Model for", PoI),
x = "Sample Time (h)",
y = "Intensity") +
theme_minimal()
PlotList[[PoI]] <- plot
}
BigPlot <- ggpubr::ggarrange(plotlist = PlotList, ncol = 3, nrow = 3, common.legend = TRUE, legend = "bottom")
X <- DataCombined %>% normalizeIntensityOnSample()
View(X)
PoIs <- significant_proteins_lme$Protein
## make heatmaps again
HeatMapData <- CorrectedDataNew %>%
filter(Protein %in% PoIs) %>%
normalizeIntensityOnFeature(method = "zscore") %>%
group_by(Protein, Sample.TimeNew) %>%
summarise(Intensity = mean(Intensity), .groups = "drop")
TimePoints <- unique(HeatMapData$Sample.TimeNew)
FullTime <- seq(7,44, by = 1)
MissingTime <- setdiff(FullTime, TimePoints)
HeatMapData <- HeatMapData %>%
## add Missing time to SampleTimeNew with NA intensity
add_row(Protein = rep(unique(HeatMapData$Protein), each = length(MissingTime)), Sample.TimeNew = rep(MissingTime, times = length(unique(HeatMapData$Protein))), Intensity = NA)
HeatMapData$Sample.TimeNew = factor(HeatMapData$Sample.TimeNew, levels = sort(unique(HeatMapData$Sample.TimeNew)))
HeatMapDataQuant  <- HeatMapData %>% pivot_wider(names_from = Sample.TimeNew, values_from = Intensity) %>%
column_to_rownames(var = "Protein")
HeatMapReal <- ComplexHeatmap::Heatmap(HeatMapDataQuant,
column_order = as.character(sort(unique(HeatMapData$Sample.TimeNew))),
name = "Intensity",
