SplineRegression <- function(dataset, PoIs, Timecol, alpha = 0.05, split_status = FALSE, plotname = "", col_pellet = "custom_vibrant", show_all_proteins = T) {
# Ensure Timecol is treated as a column name
Timecol <- rlang::ensym(Timecol)
## ceck if TimeCol is numeric
TimeIsNumeric <- is.numeric(dataset[[rlang::as_string(Timecol)]])
assign_variable <- function(dataset){
if(TimeIsNumeric == F){
Variable = as.numeric(as.factor(dataset[[Timecol]]))
}
if(TimeIsNumeric == T){
Variable = dataset[[Timecol]]
}
return(Variable)
}
### Strp 1: Fit and Plot Mean spline for PoIs (split by Status if split_Status = T)
MeanPoIsData <- dataset %>% dplyr::ungroup() %>% filter(Protein %in% PoIs)
## assign varaible to dataset
MeanPoIsVariable <- assign_variable(MeanPoIsData)
if(split_status == T){
MeanSplineData <- MeanPoIsData %>%
group_by(Status, !!Timecol) %>%
summarise(Mean = mean(Intensity, na.rm = T),
n = length(unique(Sample)),
SD = sd(Intensity, na.rm = T),
SE = SD/sqrt(n),
CI = qt(1 - alpha/2, n - 1) * SE)
## Degrees of freedom = number of Timecol entries - 1
df = length(unique(dataset[[rlang::as_string(Timecol)]])) - 1
Plot <- ggplot(MeanSplineData)+
geom_smooth(aes(x = !!Timecol, y = Mean, group = Status, colour = Status), method = "lm", formula =  y ~ splines::ns(x, df = df),se = F) +
## add ribbon
geom_ribbon(aes(x = !!Timecol, ymin = Mean - CI, ymax = Mean + CI, group = Status, fill = Status), alpha = 0.2)
} else {
MeanSplineData <- MeanPoIsData %>%
group_by(!!Timecol) %>%
summarise(Mean = mean(Intensity, na.rm = T),
n = length(unique(Sample)),
SD = sd(Intensity, na.rm = T),
SE = SD/sqrt(n),
CI = qt(1 - alpha/2, n - 1) * SE) %>%
ungroup()
## Degrees of freedom = number of Timecol entries - 1
df = length(unique(dataset[[rlang::as_string(Timecol)]])) - 1
Plot <- ggplot(MeanSplineData)+
geom_point(aes(x = !!Timecol, y = Mean)) +
geom_smooth(aes(x = !!Timecol, y = Mean, group = 1), method = "lm", formula =  y ~ splines::ns(x, df = df), se = F, color= "black") +
## add ribbon
geom_ribbon(aes(x = !!Timecol, ymin = Mean - CI, ymax = Mean + CI, group = 1), alpha = 0.2)
}
}
Plot <- Plot + geom_smooth(data = MeanPoIsData, aes(x = !!Timecol, y = Intensity, group = interaction(Protein, Status), colour = Status), method = "lm", formula =  y ~ splines::ns(x, df = df), se = F, alpha = 0.5)
Plot
Plot <- ggplot(MeanSplineData)+
geom_point(aes(x = !!Timecol, y = Mean)) +
geom_smooth(aes(x = !!Timecol, y = Mean, group = 1), method = "lm", formula =  y ~ splines::ns(x, df = df), se = F, color= "black") +
## add ribbon
geom_ribbon(aes(x = !!Timecol, ymin = Mean - CI, ymax = Mean + CI, group = 1), alpha = 0.2)
## Add splines for each protein if show_all_proteins = T
Plot <- Plot + geom_smooth(data = MeanPoIsData, aes(x = !!Timecol, y = Intensity, group = interaction(Protein, Status)), method = "lm", formula =  y ~ splines::ns(x, df = df), se = F, alpha = 0.5)
Plot
