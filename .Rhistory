## plot Histogram of variance over time
df_summary %>%
ggplot(aes(x = var_across_time)) +
geom_histogram(bins = 30, fill = "blue", color = "black") +
labs(title = "Variance of Protein Expression over Time",
x = "Variance",
y = "Count") +
theme_minimal()
## plot top and bottom 2 proteins
top_proteins <- df_summary %>%
arrange(desc(var_across_time)) %>%
head(4) %>% pull(Protein)
PoIs <- c(top_proteins)
CorrectedData %>%
filter(Protein %in% PoIs) %>%
ggplot(aes(x = Sample.Time, y = Intensity, color = Protein)) +
facet_wrap(~Protein) +
geom_point() +
geom_smooth(method = "loess") +
labs(title = "Expression of Random Proteins over Time",
x = "Sample Time (h)",
y = "Intensity") +
theme_minimal() +
## add all x axis labels
scale_x_continuous(breaks = seq(0, 24, by = 2)) +
## rotate x axis labels 45 degrees
theme(axis.text.x = element_text(angle = 45, hjust = 1)) +
theme(legend.position = "bottom")
## Define circadian period
# Assuming a 24-hour period
period <- 24
## Define FDR of the analysis
fdr <- 0.01
## define harmonic model
fit_harmonic_model <- function(data) {
lm(Intensity ~ sin(2 * pi * Sample.Time / period) + cos(2 * pi * Sample.Time / period), data = data)
}
## calculate harmonic fit fpr every protein
results <- CorrectedData %>%
group_by(Protein) %>%
nest() %>%
mutate(model = map(data, fit_harmonic_model),
tidied = map(model, tidy)) %>%
unnest(tidied) %>%
rstatix::adjust_pvalue(method = "BH")
## extract significant proteins
significant_proteins <- results %>%
filter(p.value.adj < fdr) %>%
select(Protein, term, estimate, p.value.adj) %>%
select(- p.value.adj) %>%
pivot_wider(names_from = term, values_from = estimate)
InterseptTerms <- significant_proteins %>%
select(Protein, `(Intercept)`)
VariableTerms <- significant_proteins %>%
select(- `(Intercept)`) %>%
pivot_longer(cols = contains("Sample.Time"), names_to = "term", values_to = "estimate") %>%
filter(!is.na(estimate)) %>%
pivot_wider(names_from = term, values_from = estimate)
AllTerms <- InterseptTerms %>% filter(Protein %in% VariableTerms$Protein) %>% merge(VariableTerms, by = "Protein")
## plot function for Q9Y4D1_DAAM1
plot_harmonic_fit <- function(data, protein) {
data %>%
filter(Protein == protein) %>%
ggplot(aes(x = Sample.Time, y = Intensity)) +
geom_point() +
geom_smooth(method = "lm", formula = y ~ sin(2 * pi * x / period) + cos(2 * pi * x / period), color = "blue") +
labs(title = paste(protein),
x = "Sample Time (h)",
y = "Intensity") +
theme_minimal()
}
Plots <- list()
for(protein in AllTerms$Protein) {
plot <- plot_harmonic_fit(CorrectedData, protein)
Plots[[protein]] <- plot
}
BigPlot <- ggpubr::ggarrange(plotlist = Plots, ncol = 2, nrow =2, common.legend = TRUE, legend = "bottom")
BigPlot
## expand time horizon
CorrectedDataNew <- CorrectedData %>%
mutate(Sample.Date = lubridate::date(Sample.Date)) %>%
mutate(Sample.TimeNew = Sample.Date + lubridate::hours(Sample.Time)) %>%
group_by(Patient.ID) %>%
## calculate time between samples
mutate(DayDif = max(Sample.Date) - min(Sample.Date)) %>%
## Filter for patients with consecutive samples
filter(DayDif == 1) %>%
## calculate time difference between samples
mutate(Sample.TimeNew = Sample.TimeNew - min(Sample.TimeNew)) %>%
## Convert results to hours
mutate(Sample.TimeNew = Sample.TimeNew /60 /60) %>%
## add seven hours to get time of day
mutate(Sample.TimeNew = Sample.TimeNew + 7) %>%
mutate(Sample.TimeNew = as.numeric(Sample.TimeNew))
