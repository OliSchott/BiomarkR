if("Protein" %in% base::colnames(dataset)){
dataset <- dataset %>%
tidyr::pivot_wider(id_cols = Sample,names_from = "Protein", values_from = "Intensity") %>%
tidyr::pivot_longer(cols = contains("_"), names_to = "Protein", values_to = "Intensity") %>%
## make column to denote missing values
dplyr::mutate(Is.Imputed = ifelse(is.na(Intensity), "Imputed", "Not Imputed"))
if (method == "mean" | method == "Mean"){
## Creating temporary columns
dataset <- dataset %>%
dplyr::group_by(Protein) %>%
dplyr::mutate(meanInt = base::mean(Intensity, na.rm = TRUE)) %>%
dplyr::ungroup() %>%
## Check for missing values and impute them
dplyr::mutate(Intensity = ifelse(base::is.na(Intensity), meanInt, Intensity))
## Selecting necessary columns
dataset <- dataset %>%
dplyr::select(-c("meanInt"))
base::print(base::paste("Imputed", MissingValue, "values"))
return(dataset)
}
if (method == "Zero" | method == "zero" | method == "0"){
dataset <- dataset %>% dplyr::mutate(Intensity = ifelse(base::is.na(Intensity), 0, Intensity))
base::print(base::paste("Imputed", MissingValue, "values"))
return(dataset)
}
if (method == "half_min" | method == "halfmin" | method == "HalfMin") {
dataset <- dataset %>%
## trasnsform to linear space
dplyr::group_by(Protein) %>%
dplyr::mutate(half_min = (base::min(Intensity, na.rm = TRUE) -1)) %>%
dplyr::mutate(Intensity = ifelse(base::is.na(Intensity), half_min, Intensity)) %>%
dplyr::ungroup() %>%
## back to log2 space
dplyr::mutate(Intensity = log2(Intensity)) %>%
dplyr::select(-c("half_min"))
}
## Median imputation
if (method == "median" | method == "Median") {
dataset <- dataset %>%
dplyr::group_by(Protein) %>%
dplyr::mutate(medianInt = base::median(Intensity, na.rm = TRUE)) %>%
dplyr::mutate(Intensity = ifelse(base::is.na(Intensity), medianInt, Intensity)) %>%
dplyr::select(-c("medianInt"))
}
## knn Imputation
if (method == "knn" | method == "KNN") {
datasetQuant <- dataset %>%
tidyr::pivot_wider(id_cols = "Sample",names_from = Protein, values_from = Intensity) %>%
dplyr::select(contains("_"), - Sample) %>% base::as.matrix() %>% base::t() %>%
impute::impute.knn()
datasetQuant <- datasetQuant$data %>% base::t()
datasetClin <- dataset %>%
tidyr::pivot_wider(names_from = Protein, values_from = Intensity) %>%
dplyr::select(!contains("_"))
dataset <- base::cbind(datasetClin, datasetQuant) %>%
tidyr::pivot_longer(cols= contains("_"), names_to = "Protein", values_to = "Intensity")
}
if(method == "svd" | method == "SVD"){
datasetQuant <- dataset %>%
tidyr::pivot_wider(id_cols = "Sample", names_from = Protein, values_from = Intensity) %>%
dplyr::select(Sample, contains("_")) %>%
tibble::column_to_rownames("Sample") %>%
base::as.matrix()
datasetClin <- dataset %>%
tidyr::pivot_wider(names_from = Protein, values_from = Intensity) %>%
dplyr::select(!contains("_"))
PCA <- pcaMethods::pca(datasetQuant, method = "svdImpute", nPcs = 3)
ImputedData <- PCA@completeObs %>%
base::as.data.frame() %>%
tibble::rownames_to_column("Sample") %>%
tidyr::pivot_longer(cols = contains("_"), names_to = "Protein", values_to = "Intensity") %>%
base::merge(datasetClin, by = "Sample")
dataset <- ImputedData
}
}
if("Peptide" %in% base::colnames(dataset)){
dataset <- dataset %>%
tidyr::pivot_wider(names_from = "Peptide", values_from = "Intensity") %>%
tidyr::pivot_longer(cols = contains("_"), names_to = "Peptide", values_to = "Intensity") %>%
## make column to denote missing values
dplyr::mutate(Is.Imputed = ifelse(is.na(Intensity), "Imputed", "Not Imputed"))
if (method == "mean" | method == "Mean"){
## Creating temporary columns
dataset <- dataset %>%
dplyr::group_by(Peptide) %>%
dplyr::mutate(meanInt = base::mean(Intensity, na.rm = TRUE)) %>%
dplyr::ungroup() %>%
## Check for missing values and impute them
dplyr::mutate(Intensity = ifelse(base::is.na(Intensity), meanInt, Intensity))
## Selecting necessary columns
dataset <- dataset %>%
dplyr::select(-c("meanInt"))
base::print(base::paste("Imputed", MissingValue, "values"))
return(dataset)
}
if (method == "Zero" | method == "zero" | method == "0"){
dataset <- dataset %>% dplyr::mutate(Intensity = ifelse(base::is.na(Intensity), 0, Intensity))
base::print(base::paste("Imputed", MissingValue, "values"))
return(dataset)
}
if (method == "half_min" | method == "halfmin" | method == "HalfMin") {
## trasnsform to linear space
dplyr::mutate(Intensity = 2** Intensity) %>%
dplyr::group_by(Peptide) %>%
dplyr::mutate(half_min = (base::min(Intensity, na.rm = TRUE) / 2)) %>%
dplyr::mutate(Intensity = ifelse(base::is.na(Intensity), half_min, Intensity)) %>%
## back to log2 space
dplyr::mutate(Intensity = log2(Intensity)) %>%
dplyr::select(-c("half_min"))
}
if (method == "median" | method == "Median") {
dataset <- dataset %>%
dplyr::group_by(Peptide) %>%
dplyr::mutate(medianInt = base::median(Intensity, na.rm = TRUE)) %>%
dplyr::mutate(Intensity = ifelse(base::is.na(Intensity), medianInt, Intensity)) %>%
dplyr::select(-c("medianInt"))
}
## knn Imputation
if (method == "knn" | method == "KNN") {
datasetQuant <- dataset %>%
tidyr::pivot_wider(names_from = Peptide, values_from = Intensity) %>%
dplyr::select(contains("_")) %>% base::as.matrix() %>% base::t() %>%
impute::impute.knn()
datasetQuant <- datasetQuant$data %>% base::t()
datasetClin <- dataset %>%
tidyr::pivot_wider(names_from = Peptide, values_from = Intensity) %>%
dplyr::select(!contains("_"))
dataset <- base::cbind(datasetClin, datasetQuant) %>%
tidyr::pivot_longer(cols= contains("_"), names_to = "Peptide", values_to = "Intensity")
}
## SVD Imputation
if(method == "svd" | method == "SVD"){
datasetQuant <- dataset %>%
dplyr::mutate(Intensity = as.numeric(Intensity)) %>%
tidyr::pivot_wider(names_from = Peptide, values_from = Intensity) %>%
dplyr::select(Sample, contains("_")) %>%
tibble::column_to_rownames("Sample") %>%
base::as.matrix()
datasetClin <- dataset %>%
tidyr::pivot_wider(names_from = Peptide, values_from = Intensity) %>%
dplyr::select(!contains("_"))
PCA <- pcaMethods::pca(datasetQuant, method = "svdImpute", nPcs = 3)
ImputedData <- PCA@completeObs %>%
base::as.data.frame() %>%
tibble::rownames_to_column("Sample") %>%
tidyr::pivot_longer(cols = -Sample, names_to = "Peptide", values_to = "Intensity") %>%
base::merge(datasetClin, by = "Sample")
dataset <- ImputedData
}
}
return(base::invisible(dplyr::ungroup(dataset)))
}
X <- ImputeFeatureIntensity(dataset , "svd")
