summarise(MeanInt = mean(Intensity, na.rm =T),
n = length(unqiue(Sample)),
SD = sd(Intensity, na.rm =T),
SE = SD/sqrt(n),
CI = qt(1 - alpha/2, n - 1) * SE)
## Fit the spline for the mean expression of all PoIs
MeanSplineData <- DatasetSplines %>%
## group by timecol, If split_status == T group by Status as well
{if(split_status) group_by(., Variable, Status) else group_by(., Variable)} %>%
summarise(MeanInt = mean(Intensity, na.rm =T),
n = length(unique(Sample)),
SD = sd(Intensity, na.rm =T),
SE = SD/sqrt(n),
CI = qt(1 - alpha/2, n - 1) * SE)
View(MeanSplineData)
ggplot(MeanSplineData, aes(x = Variable, y = MeanInt)) +
geom_line(color = "blue", size = 1) +
geom_ribbon(aes(ymin = MeanInt - CI, ymax = MeanInt + CI), alpha = 0.2, fill = "blue") +
labs(title = plotname, x = rlang::as_string(Timecol), y = "Mean Intensity") +
theme_minimal() +
theme(plot.title = element_text(hjust = 0.5))
ggplot(MeanSplineData, aes(x = Variable, y = MeanInt)) +
geom_point(aes(x = Variable, y = MeanInt), color = "blue", size = 3)
ggplot(MeanSplineData, aes(x = Variable, y = MeanInt)) +
geom_point(aes(x = !!TimeCol, y = MeanInt), color = "blue", size = 3)
ggplot(MeanSplineData, aes(x = Variable, y = MeanInt)) +
geom_point(aes(x = Variable, y = MeanInt), color = "blue", size = 3) +
geom_ribbon(aes(ymin = MeanInt - CI, ymax = MeanInt + CI), alpha = 0.2, fill = "blue") +
labs(title = plotname, x = rlang::as_string(Timecol), y = "Mean Intensity") +
theme_minimal() +
theme(plot.title = element_text(hjust = 0.5))
